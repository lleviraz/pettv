{
  "database": {
    "rules": "database.rules.json",
    "predeploy": ["npm run test:rules"]
  },
  "hosting": {
    "public": "web",
    "ignore": ["**/.*", "**/*.example.js"],
    "trailingSlash": true,
    "headers": [
      { "source": "**", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
      { "source": "firebase-config.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
